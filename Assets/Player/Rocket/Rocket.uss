.StatIcon {
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-type: sliced;
    background-size: contain;
    background-position-x: center 0;
    flex-grow: 0;
    flex-wrap: nowrap;
    flex-shrink: 0;
    height: 100%;
    min-width: 48px;
    margin-top: 0;
    margin-right: 8px;
    margin-bottom: 0;
    margin-left: 0;
    background-position-y: center 0;
    min-height: 48px;
    width: 10%;
    max-width: none;
    flex-basis: auto;
}

.StatRow {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 10px;
    padding-bottom: 0;
    padding-left: 4px;
    height: auto;
    min-height: auto;
}

.StatProgressBar {
    -unity-background-scale-mode: stretch-to-fill;
    width: auto;
    flex-grow: 1;
    background-image: url("project://database/Assets/Ui/UiElements.png?fileID=-5008134335625873361&guid=816d7d5ddefad52818dbd5fe00365925&type=3#UiElements_5");
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 2px;
    flex-shrink: 0;
    height: 100%;
    flex-basis: auto;
    min-height: 20px;
    flex-direction: column;
    padding-top: 2px;
    padding-right: 2px;
    padding-bottom: 2px;
    padding-left: 2px;
    min-width: auto;
}

.Bar {
    width: 100%;
    height: 100%;
    background-image: url("project://database/Assets/Ui/UiElements.png?fileID=-2044563770&guid=816d7d5ddefad52818dbd5fe00365925&type=3#UiElements_6");
    -unity-slice-scale: 2px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-slice-left: 1;
    -unity-slice-top: 1;
    -unity-slice-right: 1;
    -unity-slice-bottom: 1;
}

.OuterBar {
    padding-top: 0;
    padding-bottom: 8px;
    -unity-background-scale-mode: stretch-to-fill;
    margin-top: 8px;
}

.PlayerUI {
    -unity-slice-left: 0;
    -unity-slice-top: 0;
    -unity-slice-right: 0;
    -unity-slice-bottom: 0;
    -unity-slice-scale: 1px;
    padding-top: 4px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 4px;
}
